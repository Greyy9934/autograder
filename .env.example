# Copy this file to .env. Keep mock mode enabled until ready for paid calls.
# AI_PROVIDER defaults to gemini when mock mode is disabled.
# GEMINI_API_KEY=replace_with_your_key
# GEMINI_MODEL=gemini-3.8-flash

# DeepSeek is opt-in. Keep AUTOGRADER_MOCK_MODE=1 while testing without paid calls.
# To use DeepSeek Flash, set all three values and turn mock mode off:
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace_with_your_key
# DEEPSEEK_MODEL=deepseek-flash
# Per-agent DeepSeek completion ceilings are fixed in app/ai/output_budget.py.
# Current workflow ceiling: 55,296 completion tokens across seven requests;
# reconstruction: 6,144; per-request app limit: 16,384. Ceilings do not force the model to fill them.
# They are ceilings, not targets. Prompts/schemas constrain output length;
# DeepSeek inputs over 48 KiB are blocked before credit reservation/API calls.
# The app logs provider usage and finish_reason to make truncation diagnosable.

# App-level allowance: 350 provider calls per UTC day (50 standard 7-call submissions).
# This is not a USD spend cap; DeepSeek bills actual input/output token usage.
AI_DAILY_REQUEST_CREDITS=350

# Offline workflow simulation (no AI/API calls); never enable in production.
AUTOGRADER_MOCK_MODE=1

# Persistent UI state and grade snapshots. Create a Neon Postgres project and
# set this to its pooled connection string. Do not commit real credentials.
# NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Optional local-only SQLite path; Render production requires Neon by default.
# Set ALLOW_SQLITE_IN_PROD=1 to allow SQLite in production container if testing without Neon.
# AUTOGRADER_STATE_DB=/path/to/local-ui-state.sqlite3
# ALLOW_SQLITE_IN_PROD=0

# Hosted Code Execution (set to 1 on Render to enable C compilation, testing, and benchmarking)
HOSTED_CODE_EXECUTION_ENABLED=1
LOCAL_CODE_EXECUTION_ENABLED=1

# Instructor UI credentials (generate with python scripts/set_instructor_password.py)
AUTOGRADER_USERNAME=instructor
# AUTOGRADER_PASSWORD_HASH=pbkdf2_sha256$...
# COOKIE_SECURE=1
