# Copy this file to .env. Keep mock mode enabled until ready for paid calls.
# AI_PROVIDER defaults to gemini when mock mode is disabled.
# GEMINI_API_KEY=replace_with_your_key
# GEMINI_MODEL=gemini-3.8-flash

# DeepSeek is opt-in. Keep AUTOGRADER_MOCK_MODE=1 while testing without paid calls.
# To use DeepSeek Flash, set all three values and turn mock mode off:
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace_with_your_key
# DEEPSEEK_MODEL=deepseek-flash
# Per-agent DeepSeek completion caps are fixed in app/ai/output_budget.py.

# Hard cap on AI provider calls per UTC day (one normal grading run uses seven).
AI_DAILY_REQUEST_CREDITS=7

# Offline workflow simulation (no AI/API calls); never enable in production.
AUTOGRADER_MOCK_MODE=1

# Persistent UI state and grade snapshots. Create a Neon Postgres project and
# set this to its pooled connection string. Do not commit real credentials.
# NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Optional local-only SQLite path; Render production requires Neon instead.
# AUTOGRADER_STATE_DB=/path/to/local-ui-state.sqlite3
